{
  "name": "sc8-battery-wizard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-only wizard: behind-the-meter battery savings for a Con Edison SC 8 multifamily building",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "serve": "python3 -m http.server 8080",
    "build": "node scripts/build.mjs",
    "build:client": "node scripts/build.mjs --client",
    "serve:client": "node scripts/build.mjs --client && python3 -m http.server 8080 -d dist",
    "profiles": "node scripts/make_profiles.mjs"
  },
  "license": "UNLICENSED"
}
